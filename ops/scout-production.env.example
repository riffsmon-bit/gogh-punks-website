# Public/read-only production Scout configuration. Never add signing keys here.
# Snapshot reviewed 2026-08-20. Reconfirm ownerOf(1797) before activation.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Required for deployed reconciliation. Use a distinct origin and verify provider independence.
ROBINHOOD_SECONDARY_RPC_URL=
CHAIN_ID=4663

BROKER_INDEXER_ENABLED=true
BROKER_ANALYZER_ENABLED=true
BROKER_SCOUT_ENABLED=true
# Add OPENSEA_API_KEY separately through Netlify's secret environment UI.
# Never place the key in this tracked template.
BROKER_METADATA_ENABLED=true
BROKER_METADATA_BATCH_SIZE=12
BROKER_METADATA_REFRESH_HOURS=24
BROKER_METADATA_NOT_FOUND_REFRESH_HOURS=24
BROKER_METADATA_ERROR_REFRESH_HOURS=1
BROKER_METADATA_TIMEOUT_MS=8000
BROKER_SCOUT_TOKEN_ID=1797
BROKER_SCOUT_PERSONA=PIXEL_MAXI
BROKER_SCOUT_MAX_RECOMMENDATIONS_PER_RUN=24
BROKER_RPC_MAX_HEAD_SKEW=8
BROKER_RPC_MAX_BLOCK_AGE_SECONDS=600

# Recent bounded Scout window selected below chain head 41,393,733.
# Historical backfill can be expanded later under monitored RPC limits.
BROKER_INDEX_FROM_BLOCK_GOGH_PUNK_TRANSFERS=41300000
BROKER_INDEX_FROM_BLOCK_SEAPORT_ACTIVITY=41300000
# After deployments/robinhood.json becomes DEPLOYED, set both to the earliest reviewed
# GoghPunkAccountRegistry/GoghPunkAccountV1 deployment block and append the two account streams.
BROKER_INDEX_FROM_BLOCK_ACCOUNT_ACTIVATIONS=
BROKER_INDEX_FROM_BLOCK_ACCOUNT_ACQUISITIONS=
# Broad NFT transfer scanning starts at a recent reviewed boundary and only
# materializes zero-address ERC-721 / ERC-1155 mint signals.
BROKER_INDEX_FROM_BLOCK_NFT_TRANSFERS=41380000
BROKER_INDEX_STREAMS=gogh_punk_transfers,seaport_activity,nft_transfers
# Post-deployment core stream order:
# BROKER_INDEX_STREAMS=gogh_punk_transfers,seaport_activity,nft_transfers,account_activations,account_acquisitions
BROKER_CONFIRMATIONS=20
BROKER_REORG_WINDOW=64
BROKER_INDEX_BATCH_SIZE=1000
BROKER_INDEX_MAX_BLOCKS_PER_RUN=10000

BROKER_ANALYSIS_BATCH_SIZE=10
BROKER_ANALYSIS_RETRY_HOURS=24
BROKER_ANALYSIS_ACTIVITY_LIMIT=200
BROKER_BLOCKSCOUT_ABI_ENABLED=true

ENABLE_SCOUT_MODE=true
ENABLE_APPROVAL_PURCHASES=false
ENABLE_AUTONOMOUS_PURCHASES=false
ENABLE_AUTONOMOUS_MINTS=false
ENABLE_UNKNOWN_COLLECTION_EXECUTION=false
ENABLE_SELLING=false
ENABLE_AUTONOMOUS_SELLING=false
